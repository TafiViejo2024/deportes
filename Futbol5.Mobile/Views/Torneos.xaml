<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Futbol5.Mobile.Views.TorneosPage"
    BackgroundColor="#F5F5F5">

    <VerticalStackLayout Padding="10">

        <!-- Header -->
        <Grid ColumnDefinitions="*,Auto" Padding="10">
            <Label Text="🏆 Torneos"
                   FontSize="24"
                   FontAttributes="Bold"/>

            <Button Text="+"
                    Grid.Column="1"
                    WidthRequest="40"
                    HeightRequest="40"
                    CornerRadius="20"
                    BackgroundColor="#2E7D32"
                    TextColor="White"
                    Clicked="OnNuevoTorneo"/>
        </Grid>


        <CollectionView x:Name="TorneosList"
                SelectionMode="None">

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Frame Margin="10"
                   CornerRadius="12"
                   HasShadow="True"
                   Padding="0"
                   BackgroundColor="White"
                   BorderColor="#E0E0E0">

                        <VerticalStackLayout Spacing="0">

                            <!-- Imagen -->
                            <Image Source="{Binding ImagenSource}"
                                Aspect="AspectFill"
                                HeightRequest="180"
                                BackgroundColor="#DDD"/>             

                            <!-- Contenido -->
                            <VerticalStackLayout Padding="12"
                                         Spacing="6">

                                <Label Text="{Binding Nombre}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#222"/>

                                <Label Text="{Binding FechaInicio, StringFormat='Fecha: {0:dd/MM/yyyy}'}"
                               FontSize="13"
                               TextColor="Gray"/>

                                <Label Text="{Binding Estado}"
                               FontSize="13"
                               TextColor="#2E7D32"
                               FontAttributes="Bold"/>

                            </VerticalStackLayout>

                        </VerticalStackLayout>

                    </Frame>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </VerticalStackLayout>

</ContentPage>