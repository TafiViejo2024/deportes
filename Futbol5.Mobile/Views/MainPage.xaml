<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Futbol5.Mobile.Views.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- Header -->
            <Label Text="⚽ Futbol 5"
               FontSize="28"
               FontAttributes="Bold"
               TextColor="#222"/>

            <Label Text="Jugadores"
               FontSize="18"
               TextColor="Gray"/>

            <!-- Botón -->
            <Button Text="➕ Agregar jugador"
                BackgroundColor="#2E7D32"
                TextColor="White"
                CornerRadius="12"
                HeightRequest="50"
                Clicked="OnAgregarClicked"/>

            <!-- Lista -->
            <CollectionView x:Name="UsuariosList">

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Frame CornerRadius="12"
                           Padding="15"
                           Margin="0,5"
                           HasShadow="True"
                           BackgroundColor="White">

                            <HorizontalStackLayout Spacing="10">

                                <!-- Avatar -->
                                <Frame WidthRequest="40"
                                   HeightRequest="40"
                                   CornerRadius="20"
                                   BackgroundColor="#2E7D32"
                                   Padding="0"
                                   VerticalOptions="Center">

                                    <Label Text="👤"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       TextColor="White"/>
                                </Frame>

                                <!-- Nombre -->
                                <Label Text="{Binding Nombre}"
                                   FontSize="18"
                                   VerticalOptions="Center"
                                   TextColor="#333"/>

                            </HorizontalStackLayout>

                        </Frame>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
